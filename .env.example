# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://vyro:vyro_dev_password@localhost:5432/vyro_db"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# ─── Encryption (AES-256 for OAuth tokens) ────────────────────────────────────
ENCRYPTION_KEY="replace-with-32-char-hex-key"

# ─── Google OAuth (YouTube + Google login) ────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# ─── Meta OAuth (Instagram + Facebook + Threads) ──────────────────────────────
META_APP_ID=""
META_APP_SECRET=""
META_CALLBACK_URL="http://localhost:3001/auth/meta/callback"

# ─── TikTok OAuth ─────────────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_CALLBACK_URL="http://localhost:3001/auth/tiktok/callback"

# ─── LinkedIn OAuth ───────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_CALLBACK_URL="http://localhost:3001/auth/linkedin/callback"

# ─── Pinterest OAuth ──────────────────────────────────────────────────────────
PINTEREST_APP_ID=""
PINTEREST_APP_SECRET=""
PINTEREST_CALLBACK_URL="http://localhost:3001/auth/pinterest/callback"

# ─── X/Twitter OAuth ──────────────────────────────────────────────────────────
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
TWITTER_CALLBACK_URL="http://localhost:3001/auth/twitter/callback"

# ─── AI ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=""
# OPENAI_API_KEY=""           # fallback
AI_PROVIDER="gemini"          # "gemini" | "openai"
AI_MODEL="gemini-1.5-pro"

# ─── File Storage (Cloudflare R2 / AWS S3 compatible) ─────────────────────────
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="vyro-media"
S3_PUBLIC_URL=""

# ─── App ──────────────────────────────────────────────────────────────────────
API_PORT=3001
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"
